/* ============================================
   GHOSTPER - Neon Anime Theme
   Vibrant, Modern, Interactive Design
   ============================================ */

/* ============ Variables ============ */
:root {
    --primary-dark: #0a0a14;
    --secondary-dark: #15151f;
    --tertiary-dark: #1f1f2e;
    --text-primary: #ffffff;
    --text-secondary: #c8c8d8;
    --cyan: #00d9ff;
    --magenta: #ff006e;
    --purple: #c238ff;
    --lime: #39ff14;
    --yellow: #ffd60a;
    --orange: #ff6b35;
    --border: #2a2a4a;
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ============ Animations ============ */
@keyframes neon-glow {
    0%, 100% { text-shadow: 0 0 10px var(--cyan), 0 0 20px var(--magenta); }
    50% { text-shadow: 0 0 20px var(--cyan), 0 0 30px var(--magenta), 0 0 40px var(--purple); }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes shine {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

@keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(0, 217, 255, 0.5); }
    50% { box-shadow: 0 0 40px rgba(0, 217, 255, 0.8), 0 0 60px rgba(194, 56, 255, 0.4); }
}

@keyframes fade-in-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ============ Reset & Base ============ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: var(--primary-dark);
    color: var(--text-primary);
    line-height: 1.6;
}

a { color: var(--cyan); text-decoration: none; transition: var(--transition); }
a:hover { color: var(--magenta); }

h1, h2, h3, h4, h5, h6 { line-height: 1.3; font-weight: 700; margin-bottom: 1rem; }
h1 { font-size: 3rem; }
h2 { font-size: 2.2rem; }
h3 { font-size: 1.5rem; }
h4 { font-size: 1.2rem; }
p { margin-bottom: 1rem; color: var(--text-secondary); }

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ============ Navbar ============ */
.navbar {
    background: linear-gradient(180deg, var(--secondary-dark) 0%, var(--primary-dark) 100%);
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--cyan), var(--magenta), var(--purple)) 1;
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 1rem 0;
    box-shadow: 0 5px 30px rgba(0, 217, 255, 0.15);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.5rem;
    font-weight: 900;
    text-shadow: 0 0 20px rgba(0, 217, 255, 0.6);
    letter-spacing: 2px;
}

.logo-img {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 0 10px rgba(0, 217, 255, 0.5));
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
}

.nav-link {
    color: var(--text-secondary);
    font-weight: 700;
    transition: var(--transition);
    position: relative;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.85rem;
}

.nav-link:hover, .nav-link.active {
    color: var(--cyan);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.6);
}

.nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--cyan), var(--magenta));
    box-shadow: 0 0 10px rgba(0, 217, 255, 0.8);
}

.hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
    gap: 5px;
}

.hamburger span {
    width: 25px;
    height: 3px;
    background-color: var(--text-primary);
    transition: var(--transition);
    border-radius: 2px;
}

.hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(10px, 10px);
}

.hamburger.active span:nth-child(2) {
    opacity: 0;
}

.hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(8px, -8px);
}

/* ============ Hero ============ */
.hero {
    background: linear-gradient(135deg, var(--primary-dark) 0%, #1a0033 50%, var(--secondary-dark) 100%);
    padding: 120px 20px;
    text-align: center;
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--cyan), var(--magenta)) 1;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(0, 217, 255, 0.1) 0%, transparent 70%);
    animation: float 6s ease-in-out infinite;
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
}

.hero-content h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    animation: neon-glow 2s ease-in-out infinite;
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.hero-content p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
}

/* ============ Buttons ============ */
.btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
    text-decoration: none;
    position: relative;
    overflow: hidden;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.btn-primary {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--magenta) 100%);
    color: var(--primary-dark);
    border: 2px solid var(--cyan);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.5);
    font-weight: 800;
}

.btn-primary:hover {
    background: linear-gradient(135deg, var(--magenta) 0%, var(--purple) 100%);
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.8),
                0 0 40px rgba(255, 0, 110, 0.6),
                0 10px 30px rgba(0, 0, 0, 0.5);
}

.btn-secondary {
    background-color: transparent;
    color: var(--cyan);
    border: 2px solid var(--cyan);
    box-shadow: inset 0 0 10px rgba(0, 217, 255, 0.1);
}

.btn-secondary:hover {
    background-color: var(--cyan);
    color: var(--primary-dark);
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.8);
    transform: translateY(-3px);
}

.btn-large {
    padding: 1.2rem 2.5rem;
    font-size: 1.1rem;
}

/* ============ Featured Section ============ */
.featured {
    padding: 80px 20px;
}

.featured h2 {
    text-align: center;
    margin-bottom: 0.5rem;
    animation: neon-glow 2s ease-in-out infinite;
}

.section-subtitle {
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 3rem;
}

/* ============ Papercrafts Grid ============ */
.papercrafts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.papercraft-card {
    background: linear-gradient(135deg, var(--secondary-dark), var(--tertiary-dark));
    border: 2px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    transition: var(--transition);
    cursor: pointer;
    position: relative;
    animation: fade-in-up 0.6s ease-out;
}

.papercraft-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, transparent 0%, rgba(0, 217, 255, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
}

.papercraft-card:hover {
    border-color: var(--cyan);
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.6),
                0 15px 40px rgba(0, 0, 0, 0.6);
}

.papercraft-card:hover::before {
    opacity: 1;
}

.card-image {
    width: 100%;
    height: 250px;
    background: linear-gradient(135deg, var(--tertiary-dark), #2a1a4a);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 3rem;
}

.card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.card-content {
    padding: 1.5rem;
}

.card-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
}

.card-anime {
    font-size: 0.9rem;
    color: var(--cyan);
    margin-bottom: 0.8rem;
}

.card-difficulty {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    background-color: var(--tertiary-dark);
    border-radius: 20px;
    font-size: 0.8rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
}

.card-difficulty.easy {
    background-color: rgba(57, 255, 20, 0.15);
    color: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.3);
}

.card-difficulty.medium {
    background-color: rgba(255, 214, 10, 0.15);
    color: var(--yellow);
    border-color: var(--yellow);
    box-shadow: 0 0 10px rgba(255, 214, 10, 0.3);
}

.card-difficulty.hard {
    background-color: rgba(255, 0, 110, 0.15);
    color: var(--magenta);
    border-color: var(--magenta);
    box-shadow: 0 0 10px rgba(255, 0, 110, 0.3);
}

.card-button {
    display: block;
    width: 100%;
    padding: 0.8rem;
    background: linear-gradient(135deg, var(--purple), var(--magenta));
    color: var(--text-primary);
    border: 2px solid var(--cyan);
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: var(--transition);
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 1px;
    position: relative;
    overflow: hidden;
}

.card-button:hover {
    background: linear-gradient(135deg, var(--magenta), var(--cyan));
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.6),
                0 0 30px rgba(255, 0, 110, 0.4);
    transform: scale(1.05);
}

/* ============ Features ============ */
.features {
    padding: 80px 20px;
    background: linear-gradient(135deg, var(--primary-dark) 0%, #1a0033 50%, var(--secondary-dark) 100%);
    border-top: 2px solid;
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--cyan), var(--magenta)) 1;
}

.features h2 {
    text-align: center;
    animation: neon-glow 2s ease-in-out infinite;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
}

.feature-card {
    background: linear-gradient(135deg, var(--tertiary-dark), #2a1a4a);
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid var(--border);
    text-align: center;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.feature-card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(194, 56, 255, 0.1) 0%, transparent 70%);
    transition: var(--transition);
    pointer-events: none;
}

.feature-card:hover {
    border-color: var(--magenta);
    transform: translateY(-8px) scale(1.05);
    box-shadow: 0 0 30px rgba(194, 56, 255, 0.5),
                0 15px 40px rgba(0, 0, 0, 0.5);
}

.feature-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.feature-card h3 {
    color: var(--cyan);
    position: relative;
    z-index: 1;
}

/* ============ CTA ============ */
.cta {
    padding: 80px 20px;
    text-align: center;
}

.cta h2 {
    animation: neon-glow 2s ease-in-out infinite;
}

/* ============ Page Header ============ */
.page-header {
    padding: 60px 20px;
    background: linear-gradient(135deg, var(--secondary-dark), var(--tertiary-dark));
    border-bottom: 2px solid;
    border-image: linear-gradient(90deg, var(--cyan), var(--magenta)) 1;
    text-align: center;
}

.page-header h1 {
    animation: neon-glow 2s ease-in-out infinite;
}

/* ============ Papercrafts Page ============ */
.papercrafts-container {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    min-height: 60vh;
}

.sidebar {
    background: linear-gradient(135deg, var(--secondary-dark), var(--tertiary-dark));
    padding: 1.5rem;
    border-radius: 12px;
    border: 2px solid var(--border);
    height: fit-content;
    position: sticky;
    top: 100px;
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.1);
}

.filter-section {
    margin-bottom: 2rem;
}

.filter-section h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.4);
}

.search-input {
    width: 100%;
    padding: 0.8rem;
    background-color: var(--tertiary-dark);
    border: 2px solid var(--border);
    border-radius: 8px;
    color: var(--text-primary);
    font-size: 0.95rem;
    transition: var(--transition);
}

.search-input:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 15px rgba(0, 217, 255, 0.4);
}

.filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.filter-btn {
    padding: 0.7rem 1rem;
    background-color: var(--tertiary-dark);
    border: 2px solid var(--border);
    color: var(--text-secondary);
    border-radius: 8px;
    cursor: pointer;
    transition: var(--transition);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.85rem;
}

.filter-btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
}

.filter-btn.active {
    background: linear-gradient(135deg, var(--cyan), var(--magenta));
    color: var(--primary-dark);
    border-color: var(--cyan);
    box-shadow: 0 0 15px rgba(0, 217, 255, 0.6);
}

/* ============ Detail Page ============ */
.breadcrumb {
    padding: 1rem 20px;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
}

.detail-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 3rem 0;
    align-items: start;
}

.preview-image {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, var(--secondary-dark), var(--tertiary-dark));
    border: 3px solid;
    border-image: linear-gradient(135deg, var(--cyan), var(--magenta)) 1;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.3);
}

.detail-anime {
    color: var(--cyan);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
}

.detail-meta {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border);
}

.meta-label {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0.3rem;
}

.meta-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--cyan);
}

/* ============ Footer ============ */
.footer {
    background: linear-gradient(180deg, var(--secondary-dark), var(--primary-dark));
    border-top: 2px solid;
    border-image: linear-gradient(90deg, var(--purple), var(--magenta), var(--cyan)) 1;
    padding: 3rem 20px 1rem;
    margin-top: 4rem;
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.footer-section h4 {
    margin-bottom: 1rem;
    color: var(--cyan);
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
}

.footer-section ul {
    list-style: none;
}

.footer-section ul li {
    margin-bottom: 0.5rem;
}

.footer-section a {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.footer-section a:hover {
    color: var(--cyan);
}

.social-links {
    display: flex;
    gap: 1rem;
}

.footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* ============ Ad Spaces ============ */
.ad-space {
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.05), rgba(255, 0, 110, 0.05));
    border: 2px solid;
    border-image: linear-gradient(135deg, var(--cyan), var(--magenta)) 1;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    color: var(--cyan);
    margin: 2rem 0;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    font-weight: 700;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.6);
}

.ad-space::before {
    content: '[ Ad Space - Premium Placement ]';
}

.ad-space::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(194, 56, 255, 0.1) 0%, transparent 70%);
    animation: float 4s ease-in-out infinite;
    pointer-events: none;
}

/* ============ Responsive ============ */
@media (max-width: 768px) {
    h1 { font-size: 2rem; }
    h2 { font-size: 1.7rem; }
    
    .hero-content h1 { font-size: 2.2rem; }
    
    .nav-menu {
        display: none;
        flex-direction: column;
        gap: 1rem;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        background-color: var(--secondary-dark);
        padding: 1rem;
        border-bottom: 2px solid var(--border);
    }

    .nav-menu.active {
        display: flex;
    }

    .hamburger {
        display: flex;
    }

    .papercrafts-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    }

    .papercrafts-container {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        padding: 1rem;
        position: static;
    }

    .main-content {
        grid-column: 1;
    }

    .detail-container {
        grid-template-columns: 1fr;
    }

    .detail-image {
        position: static;
    }
}

@media (max-width: 480px) {
    .container { padding: 0 15px; }
    
    h1 { font-size: 1.5rem; }
    h2 { font-size: 1.3rem; }
    
    .hero { padding: 60px 15px; }
    .hero-content h1 { font-size: 1.6rem; }
    
    .nav-logo { font-size: 1.2rem; }
    .logo-img { width: 24px; height: 24px; }
    
    .papercrafts-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 1rem;
    }

    .btn {
        padding: 0.7rem 1.5rem;
        font-size: 0.95rem;
    }
}
